+
+/* Reveal helper used before GSAP takes over (progressive enhancement).
+   Content is only hidden when `js-anim` is present on <html>, which an inline
+   script in <head> sets — so no-JS visitors and crawlers always see copy. */
+.js-anim [data-reveal] {
+  opacity: 0;
+  transform: translateY(18px);
+  will-change: opacity, transform;
+}
+
+/* Entrance states for the two above-the-fold movers (header bar, hero photo).
+   These are set in CSS rather than by GSAP so the SSR markup never paints in its
+   final position first and then snap back. Gated twice:
+     · `js-anim` — no-JS visitors and crawlers always see the finished bar/photo
+     · `no-preference` — reduced-motion visitors get the static version, since the
+       GSAP timeline bails out early for them
