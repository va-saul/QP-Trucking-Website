+
+/**
+ * Brand assets, derived pixel-for-pixel from the supplied
+ * "QP Trucking Solutions Logo — Navy Final" artwork — the monogram and both
+ * wordmark lines are the original letterforms, never re-typeset:
+ *
+ *   qp-mark-*.png         the QP monogram alone                      (227×227)
+ *   qp-lockup-h-*.png     monogram + the two official wordmark lines (571×215)
+ *   qp-logo-*.png         the official stacked lockup, as supplied   (322×370)
+ *   qp-wordmark-*.png     just "QP Trucking / Solutions"             (322×109)
+ *
+ * Files ship at 3× so nothing softens on retina screens. `*White` variants are
+ * alpha-true silhouettes for navy surfaces; `*Navy` is the artwork colour
+ * (#0e498e).
+ */
+export const BRAND = {
+  markNavy: "/images/brand/qp-mark-navy.png",
+  markWhite: "/images/brand/qp-mark-white.png",
+  lockupNavy: "/images/brand/qp-lockup-h-navy.png",
+  lockupWhite: "/images/brand/qp-lockup-h-white.png",
+  stackedNavy: "/images/brand/qp-logo-navy.png",
+  stackedWhite: "/images/brand/qp-logo-white.png",
+  wordmarkNavy: "/images/brand/qp-wordmark-navy.png",
+  wordmarkWhite: "/images/brand/qp-wordmark-white.png",
+} as const;
+
+/** Intrinsic proportions (px) — shared by the markup and any preload hints. */
+export const BRAND_RATIO = {
+  mark: { w: 227, h: 227 },
+  lockup: { w: 571, h: 215 },
+  stacked: { w: 322, h: 370 },
+  wordmark: { w: 322, h: 109 },
+} as const;
+
+/** Official monogram only — for compact UI (drawer cards, badges, rails). */
+export function QPMark({
+  className,
+  tone = "navy",
+  priority = false,
+}: {
+  className?: string;
+  tone?: "navy" | "white";
+  priority?: boolean;
+}) {
+  return (
+    <Image
+      src={tone === "white" ? BRAND.markWhite : BRAND.markNavy}
+      alt=""
+      aria-hidden="true"
+      width={BRAND_RATIO.mark.w}
+      height={BRAND_RATIO.mark.h}
+      priority={priority}
+      className={className}
+    />
+  );
+}
+
+/**
+ * The header mark: the supplied monogram with the supplied wordmark stacked
+ * beside it, exactly as drawn. One image, so the letterforms can never drift
+ * out of sync with the artwork.
+ */
+export function Logo({
+  tone = "navy",
+  className,
+  priority = false,
+  size = "md",
+}: {
+  tone?: "navy" | "white";
+  className?: string;
+  priority?: boolean;
+  /** md = header bar (50px) · lg = drawer / hero (62px) */
+  size?: "md" | "lg";
+}) {
+  const height = size === "lg" ? "h-[52px] sm:h-[62px]" : "h-[44px] sm:h-[50px]";
+  const isWhite = tone === "white";
+  const layer = (src: string, visible: boolean, eager = false) => (
+    <Image
+      src={src}
+      alt=""
+      aria-hidden="true"
+      fill
+      // only the tone that is on screen at first paint preloads — preloading both
+      // would fetch a file that is never shown over the hero
+      priority={priority && eager}
+      sizes="(min-width: 640px) 140px, 122px"
+      className={`object-contain object-left transition-opacity duration-300 ${
+        visible ? "opacity-100" : "opacity-0"
+      }`}
+    />
+  );
+  return (
+    <Link
+      href="/"
+      className={`group inline-flex shrink-0 items-center ${className ?? ""}`}
+    >
+      <span className="sr-only">{`${org.name} — home`}</span>
+      {/* both tones render, cross-faded — so the header can turn solid on scroll
+          without the logo snapping between two different files */}
+      <span
+        data-brand-logo
+        className={`relative block aspect-[571/215] ${height} origin-left`}
+      >
+        {layer(BRAND.lockupWhite, isWhite, true)}
+        {layer(BRAND.lockupNavy, !isWhite)}
+      </span>
+    </Link>
+  );
+}
+
+/** The exact official stacked lockup — used where there is room to show it. */
+export function BrandLockup({
+  tone = "navy",
+  className,
+  height = 96,
+}: {
+  tone?: "navy" | "white";
+  className?: string;
+  height?: number;
+}) {
+  const width = Math.round((height * BRAND_RATIO.stacked.w) / BRAND_RATIO.stacked.h);
+  return (
+    <Image
+      src={tone === "white" ? BRAND.stackedWhite : BRAND.stackedNavy}
+      alt={`${org.name} logo`}
+      width={width}
+      height={height}
+      className={className}
+    />
+  );
+}
+
+/** Just the two official wordmark lines, for tight horizontal spots. */
+export function Wordmark({
+  tone = "navy",
+  className,
+}: {
+  tone?: "navy" | "white";
+  className?: string;
+}) {
+  return (
+    <Image
+      src={tone === "white" ? BRAND.wordmarkWhite : BRAND.wordmarkNavy}
+      alt=""
+      aria-hidden="true"
+      width={BRAND_RATIO.wordmark.w}
+      height={BRAND_RATIO.wordmark.h}
+      className={className}
+    />
+  );
+}
