# FMCSA QCMobile API WebKey (free; create at https://mobile.fmcsa.dot.gov/QCDevsite/ > My WebKeys).
# Set in Vercel > Project > Settings > Environment Variables, then REDEPLOY (env changes don't apply to existing builds).
FMCSA_API_KEY=

# ==============================================================================
# Lead Delivery — Momentum CRM (NowCerts AMS / GoHighLevel White-Label) + Email
# Configure at least one channel (Momentum CRM Direct API + Resend Email recommended).
# ==============================================================================

# Option A (Recommended): Direct Momentum CRM / GoHighLevel v2 API
# Create a Private Integration in Momentum CRM -> Settings -> Private Integrations
# Required scopes: contacts.readonly, contacts.write, locations/customFields.readonly,
# locations/customFields.write (optional: objects/schema.readonly, objects/record.write,
# associations.readonly, associations.write, opportunities.write)
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=yvQJy3oBoDmK005drBmX
# Automatically creates any missing custom fields on first submission (default: enabled; set to "false" to disable)
GHL_AUTO_CREATE_CUSTOM_FIELDS=true
# Optional: create an Opportunity automatically on a specific Pipeline & Stage
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# Option B (Alternative or Additional): Momentum CRM Workflow Inbound Webhook
# Create in Momentum CRM -> Automation -> Workflows -> Trigger: Inbound Webhook
# Run `npm run crm:webhook-sample` once to send all website form keys for mapping.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Email notification & insurance document delivery via Resend (verify qpfactoring.com in Resend first)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=marketing@qpfactoring.com
LEAD_FROM_EMAIL=QP Website <leads@qpfactoring.com>

# Ahrefs Web Analytics key (defaults to the QP Trucking project key if unset)
NEXT_PUBLIC_AHREFS_KEY=

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=
