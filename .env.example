# FMCSA QCMobile API webKey (create a developer account and generate a WebKey)
# https://mobile.fmcsa.dot.gov/QCDevsite/docs/apiAccess
FMCSA_API_KEY=

# Form email delivery through Resend (create a server-side API key and verify the sender domain)
RESEND_API_KEY=
EMAIL_FROM="QP Trucking Website <forms@qpfactoring.com>"

# Website form destinations. Insurance quote/intake forms go to insurance; all others go to marketing.
LEAD_EMAIL_TO=marketing@qpfactoring.com
INSURANCE_EMAIL_TO=insurance@qpfactoring.com

# Optional additional CRM webhook URL & bearer token (HubSpot, Zapier, Make, etc.)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
