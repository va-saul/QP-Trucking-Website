# FMCSA SAFER Company Snapshot API key (request free webKey from safer.fmcsa.dot.gov)
FMCSA_API_KEY=

# Optional lead webhook URL & token for CRM integrations (HubSpot, Zapier, Make, etc.)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Ahrefs Web Analytics key (defaults to the QP Trucking project key if unset)
NEXT_PUBLIC_AHREFS_KEY=

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=
