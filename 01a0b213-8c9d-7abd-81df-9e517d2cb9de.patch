+}
+
+/* ------------------------------------------------------------------ */
+/*  LINKS                                                            */
+/* ------------------------------------------------------------------ */
+.link-sweep {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  font-weight: 700;
+}
+
+.link-sweep::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  bottom: -3px;
