+#!/usr/bin/env node
+/**
+ * Re-derives every QP brand asset from the master artwork.
+ *
+ *   node brand/export-brand-assets.mjs
+ *
+ * Input : brand/qp-logo-source.png   (the official "QP Trucking Solutions
+ *                                     Logo — Navy Final" file, untouched)
+ * Output: public/images/brand/*.png, src/app/icon.png, src/app/apple-icon.png
+ *
+ * The script measures the artwork itself instead of trusting hard-coded
+ * coordinates: it finds the three ink bands (monogram, "QP Trucking",
+ * "Solutions") on the alpha channel and derives every crop from them. Swap in
+ * a new master with the same stacked structure and everything re-exports.
+ *
+ * Why the mask is resized and not the image: `sharp(...).extract()` keeps the
+ * source resolution, so an image-level resize on a joined channel is silently
+ * dropped and the artwork ends up shrunk into a corner of the canvas. Here the
+ * alpha mask is resized first, then painted flat — verified by the ink-box
+ * check at the end of every run.
+ */
+import sharp from "sharp";
+import { mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const ROOT = path.resolve(HERE, "..");
+const SRC = path.join(HERE, "qp-logo-source.png");
+const OUT = path.join(ROOT, "public/images/brand");
+const APP = path.join(ROOT, "src/app");
+
+const SCALE = 3;     // assets ship at 3x so nothing softens on retina screens
+const MARK_PAD = 6;  // optical breathing room around the monogram, source px
+const LOCKUP_GAP = 34; // monogram -> wordmark gap in the horizontal lockup
+
+const WHITE = { r: 255, g: 255, b: 255 };
+const INK_ALPHA = 40; // anything below this is anti-aliasing, not artwork
+
+mkdirSync(OUT, { recursive: true });
+
+/* ------------------------------------------------------------------ measure */
+
+const src = await sharp(SRC).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
+const W = src.info.width;
+const H = src.info.height;
+const alphaAt = (x, y) => src.data[(y * W + x) * 4 + 3];
+
+/** Bounding box of every pixel whose alpha clears the threshold. */
+function inkBox(left, top, right, bottom) {
+  let x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1;
+  for (let y = top; y <= bottom; y++) {
+    for (let x = left; x <= right; x++) {
+      if (alphaAt(x, y) > INK_ALPHA) {
+        if (x < x0) x0 = x;
+        if (x > x1) x1 = x;
+        if (y < y0) y0 = y;
+        if (y > y1) y1 = y;
+      }
+    }
+  }
+  return { left: x0, top: y0, width: x1 - x0 + 1, height: y1 - y0 + 1 };
+}
+
+// contiguous runs of rows that contain ink
+const rowInk = [];
+for (let y = 0; y < H; y++) {
+  let count = 0;
+  for (let x = 0; x < W; x++) if (alphaAt(x, y) > INK_ALPHA) count++;
+  rowInk.push(count);
+}
+const bands = [];
+let start = -1;
+for (let y = 0; y < H; y++) {
+  const on = rowInk[y] > 0;
+  if (on && start < 0) start = y;
+  if ((!on || y === H - 1) && start >= 0) {
+    bands.push([start, on ? y : y - 1]);
+    start = -1;
+  }
+}
+
+if (bands.length !== 3) {
+  throw new Error(
+    `expected 3 ink bands (monogram, "QP Trucking", "Solutions") but found ${bands.length}. ` +
+      `brand/qp-logo-source.png is not the stacked lockup this script derives from.`,
+  );
+}
+
+const MARK = inkBox(0, bands[0][0], W - 1, bands[0][1]);
+const LINE1 = inkBox(0, bands[1][0], W - 1, bands[1][1]);
+const LINE2 = inkBox(0, bands[2][0], W - 1, bands[2][1]);
+
+const TEXT = {
+  left: Math.min(LINE1.left, LINE2.left),
+  top: LINE1.top,
+  width: Math.max(LINE1.left + LINE1.width, LINE2.left + LINE2.width) - Math.min(LINE1.left, LINE2.left),
+  height: LINE2.top + LINE2.height - LINE1.top,
+};
+
+// the stacked lockup is the union of the monogram and the wordmark block —
+// the monogram is the narrower of the two, so it is centred inside it
+const stackedLeft = Math.min(MARK.left, TEXT.left);
+const stackedRight = Math.max(MARK.left + MARK.width, TEXT.left + TEXT.width);
+const stackedBox = {
+  left: stackedLeft,
+  top: MARK.top,
+  width: stackedRight - stackedLeft,
+  height: TEXT.top + TEXT.height - MARK.top,
+};
+
+/** Dominant fully-opaque colour of the artwork — the brand navy. */
+const tally = new Map();
+for (let i = 0; i < W * H; i++) {
+  if (src.data[i * 4 + 3] > 250) {
+    const key = `${src.data[i * 4]},${src.data[i * 4 + 1]},${src.data[i * 4 + 2]}`;
+    tally.set(key, (tally.get(key) || 0) + 1);
+  }
+}
+const NAVY = (([r, g, b]) => ({ r, g, b }))(
+  [...tally.entries()].sort((a, b) => b[1] - a[1])[0][0].split(",").map(Number),
+);
+
+console.log(`master      ${W}x${H}`);
+console.log(`monogram    ${MARK.width}x${MARK.height} @ ${MARK.left},${MARK.top}`);
+console.log(`wordmark    ${TEXT.width}x${TEXT.height} @ ${TEXT.left},${TEXT.top}`);
+console.log(`stacked     ${stackedBox.width}x${stackedBox.height}`);
+console.log(`brand navy  #${[NAVY.r, NAVY.g, NAVY.b].map((v) => v.toString(16).padStart(2, "0")).join("")}\n`);
+
+/* ------------------------------------------------------------------- export */
+
+const flat = async (box, colour) => {
+  const w = box.width * SCALE;
+  const h = box.height * SCALE;
+  const mask = await sharp(SRC)
+    .ensureAlpha()
+    .extract(box)
+    .extractChannel("alpha")
+    .resize({ width: w, height: h, kernel: "lanczos3" })
+    .toColourspace("b-w")
+    .raw()
+    .toBuffer();
+  const rgba = Buffer.alloc(w * h * 4);
+  for (let i = 0; i < w * h; i++) {
+    rgba[i * 4] = colour.r;
+    rgba[i * 4 + 1] = colour.g;
+    rgba[i * 4 + 2] = colour.b;
+    rgba[i * 4 + 3] = mask[i];
+  }
+  return {
+    png: await sharp(rgba, { raw: { width: w, height: h, channels: 4 } })
+      .png({ compressionLevel: 9 })
+      .toBuffer(),
+    w,
+    h,
+  };
+};
+
+const transparent = (w, h) =>
+  sharp({ create: { width: w, height: h, channels: 4, background: { r: 0, g: 0, b: 0, alpha: 0 } } });
+
+const canvas = (w, h, layers) =>
+  transparent(w, h)
+    .composite(layers.map((l) => ({ input: l.png, left: l.left, top: l.top })))
+    .png({ compressionLevel: 9 })
+    .toBuffer();
+
+/** Ink box of a finished PNG — the guard against the no-op-resize class of bug. */
+async function inkBoxOf(buf) {
+  const { data, info } = await sharp(buf).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
+  let x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1;
+  for (let y = 0; y < info.height; y++) {
+    for (let x = 0; x < info.width; x++) {
+      if (data[(y * info.width + x) * 4 + 3] > INK_ALPHA) {
+        if (x < x0) x0 = x;
+        if (x > x1) x1 = x;
+        if (y < y0) y0 = y;
+        if (y > y1) y1 = y;
+      }
+    }
+  }
+  return { w: x1 - x0 + 1, h: y1 - y0 + 1, x0, y0, W: info.width, H: info.height };
+}
+
+const written = [];
+async function save(file, buf, expect) {
+  writeFileSync(file, buf);
+  const box = await inkBoxOf(buf);
+  const ok = !expect || (box.w === expect.w && box.h === expect.h);
+  written.push({ file: path.relative(ROOT, file), canvas: `${box.W}x${box.H}`, ink: `${box.w}x${box.h}`, ok });
+}
+
+for (const [tone, colour] of [["navy", NAVY], ["white", WHITE]]) {
+  const mark = await flat(MARK, colour);
+  const text = await flat(TEXT, colour);
+
+  // 1. monogram alone, with an optical pad
+  const pad = MARK_PAD * SCALE;
+  await save(
+    path.join(OUT, `qp-mark-${tone}.png`),
+    await canvas(mark.w + pad * 2, mark.h + pad * 2, [{ ...mark, left: pad, top: pad }]),
+    { w: MARK.width * SCALE, h: MARK.height * SCALE },
+  );
+
+  // 2. the official stacked lockup, exactly as supplied
+  await save(
+    path.join(OUT, `qp-logo-${tone}.png`),
+    await canvas(stackedBox.width * SCALE, stackedBox.height * SCALE, [
+      { ...mark, left: (MARK.left - stackedBox.left) * SCALE, top: 0 },
+      { ...text, left: (TEXT.left - stackedBox.left) * SCALE, top: (TEXT.top - MARK.top) * SCALE },
+    ]),
+    { w: stackedBox.width * SCALE, h: stackedBox.height * SCALE },
+  );
+
+  // 3. horizontal lockup for the header — same artwork, monogram left, wordmark right
+  const gap = LOCKUP_GAP * SCALE;
+  const lockW = mark.w + gap + text.w;
+  const lockH = mark.h;
+  await save(
+    path.join(OUT, `qp-lockup-h-${tone}.png`),
+    await canvas(lockW, lockH, [
+      { ...mark, left: 0, top: 0 },
+      { ...text, left: mark.w + gap, top: Math.round((lockH - text.h) / 2) },
+    ]),
+    { w: lockW, h: lockH },
+  );
+
+  // 4. wordmark alone
+  await save(path.join(OUT, `qp-wordmark-${tone}.png`), text.png, { w: TEXT.width * SCALE, h: TEXT.height * SCALE });
+}
+
+/* -------------------------------------------------------------------- icons */
+
+const roundedSquare = (size, radius) =>
+  Buffer.from(
+    `<svg width="${size}" height="${size}" xmlns="http://www.w3.org/2000/svg">` +
+      `<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1">` +
+      `<stop offset="0" stop-color="#155ba8"/><stop offset="1" stop-color="#0a3568"/>` +
+      `</linearGradient></defs>` +
+      `<rect width="${size}" height="${size}" rx="${radius}" fill="url(#g)"/></svg>`,
+  );
+
+async function appIcon(size) {
+  const mark = await sharp(path.join(OUT, "qp-mark-white.png"))
+    .resize({ width: Math.round(size * 0.62) })
+    .toBuffer();
+  const m = await sharp(mark).metadata();
+  return sharp(roundedSquare(size, Math.round(size * 0.22)))
+    .composite([{ input: mark, left: Math.round((size - m.width) / 2), top: Math.round((size - m.height) / 2) }])
+    .png({ compressionLevel: 9 })
+    .toBuffer();
+}
+
+const icon512 = await appIcon(512);
+writeFileSync(path.join(APP, "icon.png"), icon512);
+writeFileSync(path.join(APP, "apple-icon.png"), await appIcon(180));
+writeFileSync(path.join(OUT, "qp-icon-512.png"), icon512);
+console.log("icons       src/app/icon.png (512), src/app/apple-icon.png (180), brand/qp-icon-512.png\n");
+
+/* ----------------------------------------------------------------- og card */
+
+const stripes = Buffer.from(
+  `<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
+     <defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
+       <stop offset="0" stop-color="#04122a"/><stop offset="0.55" stop-color="#0a2450"/><stop offset="1" stop-color="#0e498e"/>
+     </linearGradient></defs>
+     <rect width="1200" height="630" fill="url(#bg)"/>
+     <g stroke="#ffffff" stroke-opacity="0.07" stroke-width="26">
+       <path d="M-160 470 L520 130"/><path d="M-40 560 L640 220"/><path d="M960 700 L1520 420"/>
+     </g>
+     <rect x="0" y="0" width="14" height="630" fill="#f2b441" fill-opacity="0.85"/>
+   </svg>`,
+);
+
+const stack = await sharp(path.join(OUT, "qp-logo-white.png")).resize({ height: 330 }).toBuffer();
+const stackMeta = await sharp(stack).metadata();
+writeFileSync(
+  path.join(OUT, "qp-og.png"),
+  await sharp(stripes)
+    .composite([{ input: stack, left: Math.round((1200 - stackMeta.width) / 2), top: Math.round((630 - stackMeta.height) / 2) }])
+    .png({ compressionLevel: 9 })
+    .toBuffer(),
+);
+console.log("og          qp-og.png 1200x630\n");
+
+/* ------------------------------------------------------------------ report */
+
+const pad = (s, n) => String(s).padEnd(n);
+console.log(pad("file", 40) + pad("canvas", 12) + pad("ink", 12) + "check");
+for (const w of written) {
+  console.log(pad(w.file, 40) + pad(w.canvas, 12) + pad(w.ink, 12) + (w.ok ? "ok" : "MISMATCH"));
+}
+if (written.some((w) => !w.ok)) {
+  console.error("\nOne or more assets do not match the expected ink size — refusing to call this a success.");
+  process.exit(1);
+}
+console.log("\nAll assets re-derived from brand/qp-logo-source.png.");
