+  .js-anim [data-header-item] {
+    opacity: 0;
+  }
+  .js-anim [data-hero-media] {
+    opacity: 0.35;
+  }
+  .js-anim [data-header-item],
+  .js-anim [data-hero-media] {
+    animation: anim-safety 1ms linear 3s forwards;
+  }
+  @keyframes anim-safety {
+    to {
+      opacity: 1;
+    }
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] {
+    opacity: 1 !important;
+    transform: none !important;
+  }
+  .lane-line,
+  .truck-roll,
+  .marquee {
+    animation: none !important;
+  }
+}
+
+/* Accordion (FAQ) */
+.faq-panel {
+  display: grid;
+  grid-template-rows: 0fr;
+  transition: grid-template-rows 0.4s var(--ease-out-quint);
+}
+
+.faq-panel[data-open="true"] {
+  grid-template-rows: 1fr;
+}
+
+.faq-panel > div {
+  overflow: hidden;
+}
+
+/* Compact scrollbar for horizontal scrollers */
+.scroller {
+  scrollbar-width: thin;
+  -webkit-overflow-scrolling: touch;
+}
+
+.scroller::-webkit-scrollbar {
+  height: 6px;
+}
+
+.scroller::-webkit-scrollbar-thumb {
+  background: var(--color-steel-300);
+  border-radius: 999px;
+}
+
+/* Utility: prevent any hero child from forcing horizontal scroll */
+.hero-shell > * {
+  min-width: 0;
+}
