# FMCSA SAFER Company Snapshot API key (request free webKey from safer.fmcsa.dot.gov)
FMCSA_API_KEY=

# Lead delivery - configure at least one (both recommended)
# Momentum (GoHighLevel) Inbound Webhook URL from Automation > Workflows
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Email notification via Resend (verify qpfactoring.com in Resend first)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=marketing@qpfactoring.com
LEAD_FROM_EMAIL=QP Website <leads@qpfactoring.com>

# Ahrefs Web Analytics key (defaults to the QP Trucking project key if unset)
NEXT_PUBLIC_AHREFS_KEY=

# Google Search Console HTML-tag verification token (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=
