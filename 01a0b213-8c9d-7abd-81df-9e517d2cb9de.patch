+  isolation: isolate;
+  text-align: center;
+}
+
+.btn:active {
+  transform: translateY(1px) scale(0.994);
+}
+
+.btn-primary {
+  background: linear-gradient(120deg, var(--color-brand-500), var(--color-brand-400));
