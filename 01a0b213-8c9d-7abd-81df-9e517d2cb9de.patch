+}
+
+.card-hover:hover {
+  transform: translateY(-6px);
+  box-shadow: var(--shadow-lift);
+  border-color: var(--color-brand-300);
+}
+
+/* ------------------------------------------------------------------ */
+/*  MARQUEE TICKER                                                    */
+/* ------------------------------------------------------------------ */
+.marquee {
+  display: flex;
+  width: max-content;
+  animation: marquee 42s linear infinite;
+}
+
+.marquee-fast {
+  animation-duration: 26s;
+}
+
+.marquee:hover {
+  animation-play-state: paused;
+}
+
+@keyframes marquee {
+  from {
+    transform: translate3d(0, 0, 0);
+  }
+  to {
+    transform: translate3d(-50%, 0, 0);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/*  HERO: ANIMATED HIGHWAY SCENE                                      */
+/* ------------------------------------------------------------------ */
+.hero-shell {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  background:
+    radial-gradient(120% 90% at 12% 0%, rgba(47, 111, 224, 0.34), transparent 62%),
+    linear-gradient(165deg, var(--color-navy-950) 0%, var(--color-navy-800) 55%, var(--color-navy-900) 100%);
+}
+
+.lane-line {
+  background-image: repeating-linear-gradient(
+    to right,
+    rgba(255, 255, 255, 0.85) 0px,
+    rgba(255, 255, 255, 0.85) 46px,
+    transparent 46px,
+    transparent 96px
+  );
+  background-size: 96px 3px;
+  background-repeat: repeat-x;
+  height: 3px;
+  animation: lane 1.6s linear infinite;
+}
+
+@keyframes lane {
+  from {
+    background-position-x: 0;
+  }
+  to {
+    background-position-x: -96px;
+  }
+}
+
+.truck-roll {
+  animation: truck-roll 7.5s linear infinite;
+}
+
+@keyframes truck-roll {
+  0% {
+    transform: translateX(-12%);
+  }
+  100% {
+    transform: translateX(112%);
+  }
+}
+
+.pulse-ring::before {
+  content: "";
+  position: absolute;
+  inset: -6px;
+  border-radius: inherit;
+  border: 1px solid rgba(242, 180, 65, 0.55);
+  animation: pulse-ring 2.6s ease-out infinite;
+}
+
+@keyframes pulse-ring {
+  0% {
+    transform: scale(0.92);
+    opacity: 0.9;
+  }
+  70% {
+    transform: scale(1.16);
+    opacity: 0;
+  }
+  100% {
+    opacity: 0;
+  }
