+  title,
+  intro,
+  align = "left",
+  tone = "dark",
+  cta,
+  rule = true,
+}: {
+  eyebrow?: string;
+  title: string;
+  intro?: string;
+  align?: "left" | "center";
+  tone?: "dark" | "light";
+  cta?: ReactNode;
+  rule?: boolean;
