+  const isDark = tone === "dark";
+  return (
+    <div className={`flex flex-col gap-6 ${align === "center" ? "items-center text-center" : "sm:flex-row sm:items-end sm:justify-between"}`}>
+      <div className={`max-w-2xl ${align === "center" ? "mx-auto" : ""}`}>
