+import type { Metadata } from "next";
+import { SITE_URL, org } from "@/content/site";
+
+type SeoInput = {
+  title: string;
+  description: string;
+  path: string;
+  keywords?: string[];
+  image?: string;
+  /** Intrinsic size of `image` — defaults match the 1376×860 page banners. */
+  imageWidth?: number;
+  imageHeight?: number;
+  type?: "website" | "article" | "profile";
+  publishedTime?: string;
+  modifiedTime?: string;
+  noindex?: boolean;
+};
+
+/**
+ * Central metadata factory. Every page gets: canonical URL, OpenGraph,
+ * Twitter card, keyword set and an absolute image — the baseline Google,
+ * Bing, and answer engines (ChatGPT, Perplexity, Gemini, Claude) need.
+ */
+export function buildMetadata({
+  title,
+  description,
+  path,
+  keywords,
+  image = "/images/brand/qp-og.png",
+  imageWidth = image.startsWith("/images/brand/") ? 1200 : 1376,
+  imageHeight = image.startsWith("/images/brand/") ? 630 : 860,
+  type = "website",
+  publishedTime,
+  modifiedTime,
+  noindex,
+}: SeoInput): Metadata {
+  const url = `${SITE_URL}${path === "/" ? "" : path}`;
+  const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;
+
+  return {
+    // `absolute` keeps the root layout's "| QP Trucking Solutions" template
+    // from doubling the brand on pages whose title already includes it.
+    title: { absolute: title },
+    description,
+    keywords,
+    alternates: { canonical: url },
+    robots: noindex
+      ? { index: false, follow: false }
+      : {
+          index: true,
+          follow: true,
+          googleBot: { index: true, follow: true, "max-image-preview": "large", "max-snippet": -1, "max-video-preview": -1 },
+        },
+    openGraph: {
+      type,
+      url,
+      siteName: org.name,
+      title,
+      description,
+      locale: "en_US",
+      images: [{ url: ogImage, width: imageWidth, height: imageHeight, alt: title }],
+      ...(publishedTime ? { publishedTime } : {}),
+      ...(modifiedTime ? { modifiedTime } : {}),
+    },
+    twitter: {
+      card: "summary_large_image",
+      title,
+      description,
+      images: [ogImage],
+    },
+  };
+}
